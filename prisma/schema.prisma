address_ru String @default("ул. Примерная 123") @map("address_ru")
city_ro String @default("Chișinău") @map("city_ro")
city_ru String @default("Кишинев") @map("city_ru")
country_ro String @default("Moldova") @map("country_ro")
country_ru String @default("Молдова") @map("country_ru")
