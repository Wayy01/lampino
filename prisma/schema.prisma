model PromoBanner {
id Int @id @default(autoincrement())
message_ro String @map("message_ro") @db.Text
message_ru String @map("message_ru") @db.Text
ctaText_ro String @map("cta_text_ro")
ctaText_ru String @map("cta_text_ru")
ctaLink String @default("/oferte-speciale") @map("cta_link")
isActive Boolean @default(false) @map("is_active")
showOnDesktop Boolean @default(true) @map("show_desktop")
showOnMobile Boolean @default(true) @map("show_mobile")
backgroundColor String @default("#000000") @map("bg_color")
textColor String @default("#FFFFFF") @map("text_color")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

    @@map("promo_banners")

}

model SpecialOffersPage {
id Int @id @default(autoincrement())
title_ro String @default("Oferte Speciale") @map("title_ro")
title_ru String @default("Специальные предложения") @map("title_ru")
description_ro String @default("") @map("description_ro") @db.Text
description_ru String @default("") @map("description_ru") @db.Text
mediaUrl String? @map("media_url")
mediaType String @default("image") @map("media_type")
selectionMethod String @default("manual") @map("selection_method")
selectedProductIds Json @default("[]") @map("selected_product_ids")
selectedRentalPackageIds Json @default("[]") @map("selected_rental_package_ids")
filterByCategoryId Int? @map("filter_category_id")
isActive Boolean @default(false) @map("is_active")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

    @@map("special_offers_pages")

}
