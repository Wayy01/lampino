rentalPackage RentalPackage @relation(fields: [rentalPackageId], references: [id], onDelete: Cascade)

    @@map("rental_package_videos")

}

model RentalPackageVariant {
id Int @id @default(autoincrement())
rentalPackageId Int @map("rental_package_id")
name_ro String @map("name_ro")
name_ru String @map("name_ru")
size String?
price Decimal @db.Decimal(10, 2)
reducedPrice Decimal? @db.Decimal(10, 2)
isDefault Boolean @default(false) @map("is_default")
sortOrder Int @default(0) @map("sort_order")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
rentalPackage RentalPackage @relation(fields: [rentalPackageId], references: [id], onDelete: Cascade)
orderItems OrderItem[]
rentalApplications RentalApplication[]

    @@map("rental_package_variants")

