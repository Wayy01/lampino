model RentalApplication {
id Int @id @default(autoincrement())
customerName String @map("customer_name")
customerEmail String @map("customer_email")
customerPhone String @map("customer_phone")
eventType String @map("event_type")
eventDate DateTime @map("event_date")
eventEndDate DateTime? @map("event_end_date")
eventLocation String @map("event_location")
guestCount Int @map("guest_count")
additionalInfo String? @map("additional_info") @db.Text
rentalPackageId Int @map("rental_package_id")
rentalPackageVariantId Int? @map("rental_package_variant_id")
status String @default("pending")
totalPrice Decimal @map("total_price") @db.Decimal(10, 2)
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
rentalPackage RentalPackage @relation(fields: [rentalPackageId], references: [id], onDelete: Cascade)
rentalPackageVariant RentalPackageVariant? @relation(fields: [rentalPackageVariantId], references: [id], onDelete: SetNull)

    @@index([status])
    @@index([eventDate])
    @@index([eventType])
    @@index([customerEmail])
    @@index([createdAt])
    @@map("rental_applications")

