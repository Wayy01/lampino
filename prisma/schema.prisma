generator client {
provider = "prisma-client-js"
output = "../lib/generated/prisma"
}

datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
}

model Category {
id Int @id @default(autoincrement())
name_ro String
name_ru String
slug String @unique
position Int @default(0)
imageUrl String? @map("image_url")
products Product[]
rentalPackages RentalPackage[]
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

    @@map("categories")

}

model Product {
id Int @id @default(autoincrement())
name_ro String
name_ru String
description_ro String @db.Text
description_ru String @db.Text
price Decimal @db.Decimal(10, 2)
reducedPrice Decimal? @db.Decimal(10, 2)
stock Int @default(2)
hasVariants Boolean @default(false) @map("has_variants")
specifications Json? @default("{}") @map("specifications")
categoryId Int? @map("category_id")
category Category? @relation(fields: [categoryId], references: [id])
promotionId Int?
promotion Promotion? @relation(fields: [promotionId], references: [id])
featured Boolean @default(false)
featuredOrder Int @default(0) @map("featured_order")
isActive Boolean @default(true) @map("is_active")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
images ProductImage[]
videos ProductVideo[]
variants ProductVariant[]
orderItems OrderItem[]

    @@index([categoryId])
    @@index([promotionId])
    @@index([createdAt])
    @@index([price])
    @@index([categoryId, price])
    @@index([featured])
    @@index([featured, featuredOrder])
    @@index([isActive])
    @@map("products")

}

model ProductImage {
id Int @id @default(autoincrement())
productId Int @map("product_id")
imageUrl String @map("image_url")
isMain Boolean @default(false) @map("is_main")
product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@index([productId, isMain])
    @@map("product_images")

}

model ProductVideo {
id Int @id @default(autoincrement())
productId Int @map("product_id")
videoUrl String @map("video_url")
thumbnailUrl String? @map("thumbnail_url")
product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@map("product_videos")

}

model ProductVariant {
id Int @id @default(autoincrement())
productId Int @map("product_id")
name_ro String @map("name_ro")
name_ru String @map("name_ru")
size String?
price Decimal @db.Decimal(10, 2)
reducedPrice Decimal? @db.Decimal(10, 2)
stock Int @default(0)
isDefault Boolean @default(false) @map("is_default")
sortOrder Int @default(0) @map("sort_order")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
orderItems OrderItem[]

    @@map("product_variants")

}

model Order {
id Int @id @default(autoincrement())
customerName String @map("customer_name")
customerEmail String @map("customer_email")
customerPhone String? @map("customer_phone")
address String?
city String?
postalCode String? @map("postal_code")
country String?
specialInstructions String? @map("special_instructions") @db.Text
status String @default("pending")
totalPrice Decimal @map("total_price") @db.Decimal(10, 2)
createdAt DateTime @default(now()) @map("created_at")
items OrderItem[]

    @@index([status])
    @@index([createdAt])
    @@index([customerEmail])
    @@map("orders")

}

model OrderItem {
id Int @id @default(autoincrement())
orderId Int @map("order_id")
productId Int? @map("product_id")
productVariantId Int? @map("product_variant_id")
rentalPackageId Int? @map("rental_package_id")
rentalPackageVariantId Int? @map("rental_package_variant_id")
quantity Int
priceEach Decimal @map("price_each") @db.Decimal(10, 2)
rentalStart DateTime? @map("rental_start")
rentalEnd DateTime? @map("rental_end")
order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
product Product? @relation(fields: [productId], references: [id])
productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
rentalPackage RentalPackage? @relation(fields: [rentalPackageId], references: [id], onDelete: SetNull)
rentalPackageVariant RentalPackageVariant? @relation(fields: [rentalPackageVariantId], references: [id], onDelete: SetNull)

    @@index([orderId])
    @@index([productId])
    @@index([productVariantId])
    @@index([rentalPackageId])
    @@index([rentalPackageVariantId])
    @@map("order_items")

}

model AdminUser {
id Int @id @default(autoincrement())
username String @unique
email String @unique
password String
role String @default("editor")
lastLogin DateTime?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model RentalPackage {
id Int @id @default(autoincrement())
title_ro String
title_ru String
description_ro String @db.Text
description_ru String @db.Text
price Decimal @db.Decimal(10, 2)
reducedPrice Decimal? @db.Decimal(10, 2)
hasVariants Boolean @default(false) @map("has_variants")
specifications Json? @default("{}") @map("specifications")
includes_ro Json? @default("[]") @map("includes_ro")
includes_ru Json? @default("[]") @map("includes_ru")
categoryId Int? @map("category_id")
category Category? @relation(fields: [categoryId], references: [id])
promotionId Int?
promotion Promotion? @relation(fields: [promotionId], references: [id])
isActive Boolean @default(true) @map("is_active")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
images RentalPackageImage[]
videos RentalPackageVideo[]
variants RentalPackageVariant[]
orderItems OrderItem[]
rentalApplications RentalApplication[]

    @@index([categoryId])
    @@index([promotionId])
    @@index([createdAt])
    @@index([price])
    @@index([isActive])
    @@map("rental_packages")

}

model RentalPackageImage {
id Int @id @default(autoincrement())
rentalPackageId Int @map("rental_package_id")
imageUrl String @map("image_url")
isMain Boolean @default(false) @map("is_main")
rentalPackage RentalPackage @relation(fields: [rentalPackageId], references: [id], onDelete: Cascade)

    @@index([rentalPackageId, isMain])
    @@map("rental_package_images")

}

model RentalPackageVideo {
id Int @id @default(autoincrement())
rentalPackageId Int @map("rental_package_id")
videoUrl String @map("video_url")
thumbnailUrl String? @map("thumbnail_url")
rentalPackage RentalPackage @relation(fields: [rentalPackageId], references: [id], onDelete: Cascade)

    @@map("rental_package_videos")

}

model RentalPackageVariant {
id Int @id @default(autoincrement())
rentalPackageId Int @map("rental_package_id")
name_ro String @map("name_ro")
name_ru String @map("name_ru")
size String?
price Decimal @db.Decimal(10, 2)
reducedPrice Decimal? @db.Decimal(10, 2)
isDefault Boolean @default(false) @map("is_default")
sortOrder Int @default(0) @map("sort_order")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
rentalPackage RentalPackage @relation(fields: [rentalPackageId], references: [id], onDelete: Cascade)
orderItems OrderItem[]
rentalApplications RentalApplication[]

    @@map("rental_package_variants")

}

model RentalApplication {
id Int @id @default(autoincrement())
customerName String @map("customer_name")
customerEmail String @map("customer_email")
customerPhone String @map("customer_phone")
eventType String @map("event_type")
eventDate DateTime @map("event_date")
eventEndDate DateTime? @map("event_end_date")
eventLocation String @map("event_location")
guestCount Int @map("guest_count")
additionalInfo String? @map("additional_info") @db.Text
rentalPackageId Int @map("rental_package_id")
rentalPackageVariantId Int? @map("rental_package_variant_id")
status String @default("pending")
totalPrice Decimal @map("total_price") @db.Decimal(10, 2)
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
rentalPackage RentalPackage @relation(fields: [rentalPackageId], references: [id], onDelete: Cascade)
rentalPackageVariant RentalPackageVariant? @relation(fields: [rentalPackageVariantId], references: [id], onDelete: SetNull)

    @@index([status])
    @@index([eventDate])
    @@index([eventType])
    @@index([customerEmail])
    @@index([createdAt])
    @@map("rental_applications")

}

model Promotion {
id Int @id @default(autoincrement())
name_ro String
name_ru String
description_ro String? @db.Text
description_ru String? @db.Text
startDate DateTime
endDate DateTime
discountPercent Float
featured Boolean @default(false)
products Product[]
rentals RentalPackage[]

    @@map("promotions")

}

model ThemeSettings {
id Int @id @default(autoincrement())
colorPrimary String @default("#3B82F6") @map("color_primary")
colorSecondary String @default("#10B981") @map("color_secondary")
colorTertiary String @default("#F59E0B") @map("color_tertiary")
colorAccent String @default("#8B5CF6") @map("color_accent")
colorSuccess String @default("#22C55E") @map("color_success")
colorWarning String @default("#F97316") @map("color_warning")
colorError String @default("#EF4444") @map("color_error")
colorInfo String @default("#06B6D4") @map("color_info")
isActive Boolean @default(true) @map("is_active")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

    @@map("theme_settings")

}

model HeroContent {
id Int @id @default(autoincrement())
leftHeading_ro String @map("left_heading_ro")
leftHeading_ru String @map("left_heading_ru")
leftButtonText_ro String @map("left_button_text_ro")
leftButtonText_ru String @map("left_button_text_ru")
leftButtonUrl String @map("left_button_url")
leftImageUrl String? @map("left_image_url")
rightImageUrl String? @map("right_image_url")
leftMediaUrl String? @map("left_media_url")
leftMediaType String @default("image") @map("left_media_type")
rightMediaUrl String? @map("right_media_url")
rightMediaType String @default("image") @map("right_media_type")
isActive Boolean @default(true) @map("is_active")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

    @@map("hero_content")

}

model HomepageSettings {
id Int @id @default(autoincrement())
featuredCategoryIds Json @default("[]") @map("featured_category_ids")
maxCategories Int @default(3) @map("max_categories")
featuredProductsCategoryId Int? @map("featured_products_category_id")
featuredRentalsCategoryId Int? @map("featured_rentals_category_id")
isActive Boolean @default(true) @map("is_active")
welcomeHeading_ro String @default("Bine ați venit") @map("welcome_heading_ro")
welcomeHeading_ru String @default("Добро пожаловать") @map("welcome_heading_ru")
welcomeDescription_ro String @default("Descriere") @map("welcome_description_ro") @db.Text
welcomeDescription_ru String @default("Описание") @map("welcome_description_ru") @db.Text
welcomeButtonText_ro String @default("Explorează") @map("welcome_button_text_ro")
welcomeButtonText_ru String @default("Исследовать") @map("welcome_button_text_ru")
welcomeButtonUrl String @default("/magazin") @map("welcome_button_url")
categoryHeading_ro String @default("Categorii") @map("category_heading_ro")
categoryHeading_ru String @default("Категории") @map("category_heading_ru")
productHeading_ro String @default("Produse") @map("product_heading_ro")
productHeading_ru String @default("Продукты") @map("product_heading_ru")
rentalHeading_ro String @default("Închiriere") @map("rental_heading_ro")
rentalHeading_ru String @default("Аренда") @map("rental_heading_ru")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

    @@map("homepage_settings")

}

model DeliverySettings {
id Int @id @default(autoincrement())
freeDeliveryThreshold Decimal @default(1500) @map("free_delivery_threshold") @db.Decimal(10, 2)
deliveryCostChisinau Decimal @default(50) @map("delivery_cost_chisinau") @db.Decimal(10, 2)
deliveryCostOutside Decimal @default(90) @map("delivery_cost_outside") @db.Decimal(10, 2)
isActive Boolean @default(true) @map("is_active")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

    @@map("delivery_settings")

}

model ContactSettings {
id Int @id @default(autoincrement())
phone String @default("+373 675 24 111") @map("phone")
email String @default("contact@lampino.md") @map("email")
whatsapp String @default("+373 675 24 111") @map("whatsapp")
address_ro String @default("Str. Exemplu 123") @map("address_ro")
address_ru String @default("ул. Примерная 123") @map("address_ru")
city_ro String @default("Chișinău") @map("city_ro")
city_ru String @default("Кишинев") @map("city_ru")
country_ro String @default("Moldova") @map("country_ro")
country_ru String @default("Молдова") @map("country_ru")
businessHours_ro String @default("Lun-Vin: 9:00 - 18:00") @map("business_hours_ro")
businessHours_ru String @default("Пн-Пт: 9:00 - 18:00") @map("business_hours_ru")
facebookUrl String @default("https://www.facebook.com/lampino.md") @map("facebook_url")
instagramUrl String @default("https://www.instagram.com/lampino.md") @map("instagram_url")
tiktokUrl String @default("") @map("tiktok_url")
isActive Boolean @default(true) @map("is_active")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

