generator client {
provider = "prisma-client-js"
output = "../lib/generated/prisma"
// Emit both the local (macOS) engine and the Linux engine prod runs on, so the
// committed client works on either without a platform-specific regenerate.
binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
}

model Category {
id Int @id @default(autoincrement())
name_ro String
name_ru String
slug String @unique
// Storefront URL slugs (`categorySlug`) the category had before a rename; they 308 to the current one.
formerSlugs String[] @default([]) @map("former_slugs")
position Int @default(0)
imageUrl String? @map("image_url")
// Landing-page SEO content (`/<lang>/magazin/<slug>`). Every field is
// optional: empty falls back to a default built from the name.
urlSlug_ro String @default("") @map("url_slug_ro")
urlSlug_ru String @default("") @map("url_slug_ru")
seoTitle_ro String @default("") @map("seo_title_ro")
seoTitle_ru String @default("") @map("seo_title_ru")
seoDescription_ro String @default("") @map("seo_description_ro")
seoDescription_ru String @default("") @map("seo_description_ru")
h1_ro String @default("") @map("h1_ro")
h1_ru String @default("") @map("h1_ru")
intro_ro String @default("") @db.Text @map("intro_ro")
intro_ru String @default("") @db.Text @map("intro_ru")
body_ro String @default("") @db.Text @map("body_ro")
body_ru String @default("") @db.Text @map("body_ru")
// [{ q, a }] per language.
faq_ro Json @default("[]") @map("faq_ro")
faq_ru Json @default("[]") @map("faq_ru")
ogImageUrl String? @map("og_image_url")
products Product[]
rentalPackages RentalPackage[]
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

    @@map("categories")

}

model Product {
id Int @id @default(autoincrement())
name_ro String
name_ru String
description_ro String @db.Text
description_ru String @db.Text
price Decimal @db.Decimal(10, 2)
reducedPrice Decimal? @db.Decimal(10, 2)
stock Int @default(2)
hasVariants Boolean @default(false) @map("has_variants")
specifications Json? @default("{}") @map("specifications")
weightGrams Int? @map("weight_grams")
lengthMm Int? @map("length_mm")
widthMm Int? @map("width_mm")
heightMm Int? @map("height_mm")
categoryId Int? @map("category_id")
category Category? @relation(fields: [categoryId], references: [id])
promotions Promotion[] @relation("ProductPromotions")
featured Boolean @default(false)
featuredOrder Int @default(0) @map("featured_order")
// Position inside its category, set by drag in /admin/<lang>/categories/<id>/products.
// The category page's default sort follows it.
categoryOrder Int @default(0) @map("category_order")
isActive Boolean @default(true) @map("is_active")
// Set by the admin "delete": the row stays so its old URLs keep redirecting (see `redirectRetiredProduct`).
deletedAt DateTime? @map("deleted_at")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
// Alt text for the product's images; empty falls back to name + category.
imageAlt_ro String @default("") @map("image_alt_ro")
imageAlt_ru String @default("") @map("image_alt_ru")
reviews Review[]
images ProductImage[]
videos ProductVideo[]
variants ProductVariant[]
orderItems OrderItem[]

    @@index([categoryId])
    @@index([createdAt])
    @@index([price])
    @@index([categoryId, price])
    @@index([categoryId, categoryOrder])
    @@index([featured])
    @@index([featured, featuredOrder])
    @@index([isActive])
    @@map("products")

}

model ProductImage {
id Int @id @default(autoincrement())
productId Int @map("product_id")
imageUrl String @map("image_url")
isMain Boolean @default(false) @map("is_main")
product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@index([productId, isMain])
    @@map("product_images")

}

model ProductVideo {
id Int @id @default(autoincrement())
productId Int @map("product_id")
videoUrl String @map("video_url")
thumbnailUrl String? @map("thumbnail_url")
product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@map("product_videos")

}

model ProductVariant {
id Int @id @default(autoincrement())
productId Int @map("product_id")
name_ro String @map("name_ro")
name_ru String @map("name_ru")
size String?
price Decimal @db.Decimal(10, 2)
reducedPrice Decimal? @db.Decimal(10, 2)
stock Int @default(0)
weightGrams Int? @map("weight_grams")
lengthMm Int? @map("length_mm")
widthMm Int? @map("width_mm")
heightMm Int? @map("height_mm")
isDefault Boolean @default(false) @map("is_default")
sortOrder Int @default(0) @map("sort_order")
// Subset of the product's image URLs shown when this variant is selected;
// empty = show every product image. By URL, because product images are
// rebuilt wholesale (new ids) on every save.
imageUrls String[] @default([]) @map("image_urls")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
orderItems OrderItem[]

    @@map("product_variants")

}

model Order {
id Int @id @default(autoincrement())
customerName String @map("customer_name")
customerEmail String @map("customer_email")
customerPhone String? @map("customer_phone")
address String?
city String?
postalCode String? @map("postal_code")
country String?
specialInstructions String? @map("special_instructions") @db.Text
status String @default("pending")
totalPrice Decimal @map("total_price") @db.Decimal(10, 2)
// True while this order's units are taken out of stock (see lib/stock.ts).
// Orders placed before stock tracking existed stay false and never restock.
stockReserved Boolean @default(false) @map("stock_reserved")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime? @updatedAt @map("updated_at")
// Origin that created the order: "web" (storefront checkout) or the Ligatto AI-agent's name (automation API).
source String @default("web")
// Optional dedupe key from the automation API; nullable + unique so many NULLs coexist.
idempotencyKey String? @unique @map("idempotency_key")
// Delivery choice at order time: "pickup" | "delivery" and the region the fee was quoted for.
// Retained (not just used once) so a pending order's fee can be recomputed when its items change.
deliveryMethod String? @map("delivery_method")
deliveryRegion String? @map("delivery_region")
// Opaque correlation id supplied by the automation caller (e.g. a Ligatto
// conversation id). Echoed back on outbound webhooks via the {{webhook_listener_id}}
// placeholder so the receiver can tie a shipment event to its conversation.
webhookListenerId String? @map("webhook_listener_id")
items OrderItem[]
shipments Shipment[]

    @@index([status])
    @@index([createdAt])
    @@index([customerEmail])
    @@map("orders")

}

model OrderItem {
id Int @id @default(autoincrement())
orderId Int @map("order_id")
productId Int? @map("product_id")
productVariantId Int? @map("product_variant_id")
rentalPackageId Int? @map("rental_package_id")
rentalPackageVariantId Int? @map("rental_package_variant_id")
quantity Int
priceEach Decimal @map("price_each") @db.Decimal(10, 2)
rentalStart DateTime? @map("rental_start")
rentalEnd DateTime? @map("rental_end")
order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
product Product? @relation(fields: [productId], references: [id])
productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
rentalPackage RentalPackage? @relation(fields: [rentalPackageId], references: [id], onDelete: SetNull)
rentalPackageVariant RentalPackageVariant? @relation(fields: [rentalPackageVariantId], references: [id], onDelete: SetNull)

    @@index([orderId])
    @@index([productId])
    @@index([productVariantId])
    @@index([rentalPackageId])
    @@index([rentalPackageVariantId])
    @@map("order_items")

}

// A courier shipment created for an order. One order may have several
// (partial shipments / multiple parcels per carrier). Created only after the
// courier API returns a waybill, so `trackingNumber` (the AWB) is always set.
// `carrier` is "novapost" | "fancourier"; `payload` keeps the exact request
// sent to the courier for audit/debugging. API keys never live here — they are
// server-only env vars; non-secret config lives in ShippingSettings.
model Shipment {
id Int @id @default(autoincrement())
// One waybill per order: the unique constraint is the authoritative guard the
// create-shipment action relies on (it reserves this row BEFORE calling the
// courier, so a concurrent or retried submit can't mint a second real waybill).
orderId Int @unique @map("order_id")
carrier String
carrierTitle String? @map("carrier_title")
trackingNumber String @map("tracking_number")
courierShipmentId String? @map("courier_shipment_id")
status String @default("created")
codAmount Decimal? @map("cod_amount") @db.Decimal(10, 2)
labelUrl String? @map("label_url")
payload Json? @default("{}")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

    @@index([carrier])
    @@index([trackingNumber])
    @@map("shipments")

}

model AdminUser {
id Int @id @default(autoincrement())
username String @unique
email String @unique
password String
role String @default("editor")
lastLogin DateTime?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model RentalPackage {
id Int @id @default(autoincrement())
title_ro String
title_ru String
description_ro String @db.Text
description_ru String @db.Text
price Decimal @db.Decimal(10, 2)
reducedPrice Decimal? @db.Decimal(10, 2)
hasVariants Boolean @default(false) @map("has_variants")
specifications Json? @default("{}") @map("specifications")
includes_ro Json? @default("[]") @map("includes_ro")
includes_ru Json? @default("[]") @map("includes_ru")
categoryId Int? @map("category_id")
category Category? @relation(fields: [categoryId], references: [id])
promotions Promotion[] @relation("RentalPromotions")
isActive Boolean @default(true) @map("is_active")
// Set by the admin "delete": the row stays so its old URLs keep redirecting (see `redirectRetiredProduct`).
deletedAt DateTime? @map("deleted_at")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
images RentalPackageImage[]
videos RentalPackageVideo[]
variants RentalPackageVariant[]
orderItems OrderItem[]
rentalApplications RentalApplication[]

    @@index([categoryId])
    @@index([createdAt])
    @@index([price])
    @@index([isActive])
    @@map("rental_packages")

}

model RentalPackageImage {
