perks_ru String[] @default([]) @map("perks_ru")
updatedAt DateTime @updatedAt @map("updated_at")

    @@map("product_page_settings")

}

// Courier integration config (Nova Post + Fan Courier). Singleton row, read
// with findFirst({ where: { isActive: true } }) like the other *Settings
// models. API keys ARE stored here but ENCRYPTED at rest (AES-256-GCM, see
// novapostApiKey) — never plaintext. Parcel sizes use each courier's native
// units (Nova Post g/mm, Fan Courier kg/cm).
model ShippingSettings {
id Int @id @default(autoincrement())

// Nova Post
novapostEnabled Boolean @default(false) @map("novapost_enabled")
novapostSandbox Boolean @default(false) @map("novapost_sandbox")
// API key, stored ENCRYPTED at rest (AES-256-GCM via lib/admin/crypto). Never
// a raw token. Admin-editable + write-only: the plaintext never leaves the
// server. Empty string = not configured.
novapostApiKey String @default("") @map("novapost_api_key")
novapostSenderCompanyTin String @default("") @map("novapost_sender_company_tin")
novapostSenderDivisionId String @default("") @map("novapost_sender_division_id")
// Human-readable label of the chosen division, stored so the config screen can
// show a name instead of a bare id. Display-only; the id is the source of truth.
novapostSenderDivisionName String @default("") @map("novapost_sender_division_name")
novapostSenderCountryCode String @default("MD") @map("novapost_sender_country_code")
novapostDefaultCategory String @default("") @map("novapost_default_category")
// Sender identity (per courier)
novapostSenderName String @default("") @map("novapost_sender_name")
novapostSenderPhone String @default("") @map("novapost_sender_phone")
novapostSenderEmail String @default("") @map("novapost_sender_email")
// Default parcel in Nova Post's native units (grams + millimetres). Fallback for
// an order line when neither the variant nor the product carries its own size.
novapostParcelWeightG Int @default(2000) @map("novapost_parcel_weight_g")
novapostParcelLengthMm Int @default(240) @map("novapost_parcel_length_mm")
novapostParcelWidthMm Int @default(160) @map("novapost_parcel_width_mm")
novapostParcelHeightMm Int @default(200) @map("novapost_parcel_height_mm")

// Fan Courier
fancourierEnabled Boolean @default(false) @map("fancourier_enabled")
// API key, stored ENCRYPTED at rest (see novapostApiKey). Empty = not set.
fancourierApiKey String @default("") @map("fancourier_api_key")
fancourierUseDefaultSender Boolean @default(true) @map("fancourier_use_default_sender")
fancourierServiceType String @default("standard") @map("fancourier_service_type")
fancourierSenderCounty String @default("") @map("fancourier_sender_county")
fancourierSenderCity String @default("") @map("fancourier_sender_city")
fancourierSenderStreet String @default("") @map("fancourier_sender_street")
fancourierSenderNr String @default("") @map("fancourier_sender_nr")
fancourierSenderZipcode String @default("") @map("fancourier_sender_zipcode")
fancourierDefaultCategory String @default("") @map("fancourier_default_category")
// Sender identity (per courier)
fancourierSenderName String @default("") @map("fancourier_sender_name")
fancourierSenderPhone String @default("") @map("fancourier_sender_phone")
fancourierSenderEmail String @default("") @map("fancourier_sender_email")
// Default parcel in Fan Courier's native units (kilograms + centimetres).
// Fallback for a line when neither the variant nor the product carries its size.
fancourierParcelWeightKg Decimal @default(1) @map("fancourier_parcel_weight_kg") @db.Decimal(6, 3)
fancourierParcelLengthCm Int @default(24) @map("fancourier_parcel_length_cm")
fancourierParcelWidthCm Int @default(16) @map("fancourier_parcel_width_cm")
fancourierParcelHeightCm Int @default(20) @map("fancourier_parcel_height_cm")

isActive Boolean @default(true) @map("is_active")
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

    @@map("shipping_settings")

}

// Ligatto (chat-automation platform) order-automation integration. One row per
// agent — a named bearer credential, managed under admin Integrations → Ligatto.
// An AI agent authenticates to `/api/automation/orders` with the agent's `token`
// (stored ENCRYPTED at rest, AES-256-GCM via lib/admin/crypto); the matched
// agent's `name` is stamped onto `Order.source` as the order's origin.
model LigattoAgent {
id Int @id @default(autoincrement())
name String @unique
token String
enabled Boolean @default(true)
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

    @@map("ligatto_agents")

}

// A configured outbound webhook endpoint. Lampino POSTs the chosen `event` here
// (type picked from WEBHOOK_EVENTS in lib/webhooks-events.ts) so external systems
// — chiefly Ligatto — react to it. Lampino does not authenticate: if the receiver
// requires a token, the admin supplies it via `headers` (an optional editor blob,
// "Name: value" per line, e.g. `Authorization: Bearer …`) merged into every
// request.
model WebhookEndpoint {
id Int @id @default(autoincrement())
name String @unique
url String
event String @default("shipment.created")
headers String?
// When true, only fire for orders that carry a correlation id
// (Order.webhookListenerId) — i.e. automation-placed orders. Keeps storefront
// orders (and their PII) from reaching correlation-only receivers like Ligatto.
requiresListenerId Boolean @default(false) @map("requires_listener_id")
enabled Boolean @default(true)
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
deliveries WebhookDelivery[]

    @@map("webhook_endpoints")

}

// One delivery attempt-set to an endpoint, written after dispatch settles (there
// is no job queue — dispatch runs in-process, fire-and-forget, with a few
// retries). It is the admin's observability substitute for a queue: `orderId`
// and `shipmentId` are denormalized refs (no FK) for cross-reference only.
model WebhookDelivery {
id Int @id @default(autoincrement())
deliveryId String @unique @map("delivery_id")
endpointId Int @map("endpoint_id")
event String
orderId Int? @map("order_id")
shipmentId Int? @map("shipment_id")
status String @default("pending")
attempts Int @default(0)
httpStatus Int? @map("http_status")
error String?
payload Json?
createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")
endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

    @@index([endpointId])
    @@index([createdAt])
    @@map("webhook_deliveries")

}

