# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# admin media uploads (local storage)
/public/uploads/

# large binaries / installers
*.dmg

# raw 3D exports — public/pergola-lights.{bin,png} are baked from the .glb by
# `bun run build:pergola`, and the .obj/.mtl pair is a 55mb duplicate of it
/assets/3d/*.obj
/assets/3d/*.mtl

# playwright mcp session artifacts
/.playwright-mcp/
